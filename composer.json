{
  "name": "odpc-platform-x/php-oidc-odpc-x-idp",
  "description": "Reusable Laravel OIDC (authorization-code + PKCE flow) package against the ODPCX IdP Link.",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "firebase/php-jwt": "^7.0",
    "illuminate/support": "^11.0|^12.0",
    "illuminate/http": "^11.0|^12.0",
    "illuminate/auth": "^11.0|^12.0",
    "illuminate/routing": "^11.0|^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0",
    "pestphp/pest": "^3.0",
    "pestphp/pest-plugin-laravel": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "OdpcPlatformX\\PhpOidcOdpcXIdp\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OdpcPlatformX\\PhpOidcOdpcXIdp\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": ["OdpcPlatformX\\PhpOidcOdpcXIdp\\OdpcxAuthServiceProvider"]
    }
  },
  "scripts": {
    "test": "vendor/bin/pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
